# Frontend network config (copy to .env — optional, all defaults work with the Vite proxy)

# Full backend origin. Leave empty to hit the SAME origin and let the Vite dev
# proxy forward /api and /health to VITE_PROXY_TARGET. Set it (e.g.
# http://localhost:8000) to call the backend directly without a proxy.
VITE_API_URL=

# Backend origin that `npm run dev` proxies /api and /health to.
VITE_PROXY_TARGET=http://localhost:8000