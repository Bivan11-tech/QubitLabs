# QubitLabs backend environment
# Copy this file to .env and fill in real values. NEVER commit .env.

# Google Gemini API key (used by the AI tutor service on the backend only).
# Required. The backend will refuse to start the AI endpoints without it.
GEMINI_API_KEY=

# Comma-separated list of allowed CORS origins for the frontend.
# For local development point this at the Vite dev server.
FRONTEND_URL=http://localhost:5173

# Host/port for uvicorn.
HOST=0.0.0.0
PORT=8000
